FROM node:24-alpine AS builder

WORKDIR /build
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/ apps/web/
COPY packages/ packages/
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter web build

FROM nginx:1.30-alpine
# nginx renders templates into conf.d at start-up, substituting only
# OPENSYNAPSE_* variables. The default upstream is the Docker Compose service;
# the Helm chart points it at the control plane's Service.
ENV OPENSYNAPSE_API_UPSTREAM=control-plane:8090     NGINX_ENVSUBST_FILTER=OPENSYNAPSE_
COPY deploy/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /build/apps/web/dist /usr/share/nginx/html
EXPOSE 8080
